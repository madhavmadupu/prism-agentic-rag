# ──────────────────────────────────────────────
# P.R.I.S.M. — Environment Configuration
# Pipeline for Retrieval, Inference, & Structured Memory
# ──────────────────────────────────────────────

# === LLM Providers ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === Embeddings & Retrieval ===
COHERE_API_KEY=...
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=prism-index
PINECONE_ENVIRONMENT=us-east-1-aws

# === Graph Database (Neo4j) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=...

# === Cache (Redis) ===
REDIS_URL=redis://localhost:6379

# === Application ===
APP_NAME=P.R.I.S.M.
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# === Evaluation ===
RAGAS_APP_URL=...
TRULENS_API_KEY=...

# === MCP (Model Context Protocol) ===
MCP_SERVER_PORT=5000
YAHOO_FINANCE_API_KEY=...
